{
  "name": "dsh-mcp",
  "version": "0.1.4",
  "private": true,
  "description": "Generic local stdio MCP for supervised DSH Desktop tasks, explicit native sessions and durable reports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "dsh-mcp": "./bin/dsh-mcp.js",
    "codex-dsh-mcp": "./bin/codex-dsh-mcp.js"
  },
  "exports": {
    ".": "./lib/server.js",
    "./overlay": "./lib/overlay.js",
    "./stream": "./lib/dsh-stream.js",
    "./report-queue": "./lib/report-queue.js",
    "./sessions": "./lib/sessions.js"
  },
  "files": [
    "bin",
    "lib",
    "dsh-plugin",
    "docs/public",
    "docs/releases",
    "README.md",
    "LICENSE",
    "package-lock.json"
  ],
  "scripts": {
    "start": "node ./bin/dsh-mcp.js",
    "test": "node scripts/test.js",
    "bootstrap": "node ./bin/dsh-mcp.js bootstrap",
    "build:native": "node scripts/build-native.js",
    "build:release": "node scripts/build-release.js",
    "validate:package": "node scripts/validate-package.js",
    "check:dsh-contract": "node scripts/check-dsh-contract.js",
    "check:guardian": "node scripts/check-guardian.js",
    "config": "node ./bin/dsh-mcp.js config",
    "migrate-state": "node ./bin/dsh-mcp.js migrate-state"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.5",
    "ajv": "^8.20.0"
  }
}
