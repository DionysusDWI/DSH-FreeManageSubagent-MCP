{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dsh": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/codex-dsh-mcp.js"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "CODEX_DSH_MCP_ACCEPTANCE_CONTROL": "${PLUGIN_DATA}/acceptance/control.json",
        "CODEX_DSH_MCP_PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "CODEX_DSH_MCP_PLUGIN_DATA": "${PLUGIN_DATA}"
      }
    }
  }
}
